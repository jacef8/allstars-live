<?xml version="1.0" encoding="utf-8"?>
<!-- Window background: the Android 12+ OS splash (navy, star icon) runs BEFORE this — that one
     field (windowSplashScreenBackground in themes.xml) only accepts a solid color, a real platform
     limitation with no workaround. Everything after it is turf, though: this drawable is what shows
     right after that OS splash ends (while Compose/the WebView are still loading) and on pre-S
     devices that skip the new SplashScreen API entirely, and android:windowBackground CAN be an
     image. jford, 2026-07-08: "all backgrounds should have the blue turf... should never have a
     solid navy." -->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
        android:src="@drawable/splash_turf"
        android:gravity="fill" />
