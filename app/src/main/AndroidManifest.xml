<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The web app, Firestore, YouTube Live; the camera pushes RTMP to us over local Wi-Fi. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Nothing calls this. Android 14+ refuses to start a "connectedDevice" foreground service
         (RtmpReceiverService) unless the app holds FOREGROUND_SERVICE_CONNECTED_DEVICE AND one of a
         short list of device permissions; this normal-level one (no prompt) is that one. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- Keep awake during a broadcast; the scorer is handheld for a full game. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- M3: mic audio for the YouTube stream (Live requires an audio track). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- All-in-one mode: capture this device's own camera (the camera is also the scorer). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- Keep the RTMP receiver listening while the Mevo app is foreground (one-tablet
         reality: you leave our app to press Go Live, which would otherwise freeze us). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Light haptic confirm on scoring-button taps (navigator.vibrate from the web is a silent no-op without this). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Package visibility (Android 11+): so we can detect/launch the Mevo Multicam app
         from the camera setup sheet ("Open the Mevo app"). -->
    <queries>
        <package android:name="com.mevo.multicam" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AllStarsLive"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustPan"
            android:theme="@style/Theme.AllStarsLive">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ingest.RtmpReceiverService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- FCM push notifications (game reminders, live scoring, schedule, chat). -->
        <service
            android:name=".push.PushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
